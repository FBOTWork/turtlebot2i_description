<?xml version="1.0"?>
<!--
    - Base      : kobuki
    - Stacks    : interbotix
    - 3d Sensor : d435

    - arm : TODO: supported arms?
-->
<robot name="turtlebot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro" />
  <xacro:include filename="$(find turtlebot2i_description)/urdf/turtlebot_library.urdf.xacro" />
  <kobuki/>

  <stack_interbotix parent="base_link"/>

  <!-- <xacro:kinect_v2 parent="arm_base_link">
    <origin xyz="-0.10 0.0 0.41" rpy="0.0 0.56 0.0"/>
  </xacro:kinect_v2>
  -->

  <xacro:sensor_d435i parent="arm_base_link">
    <!-- <origin xyz="-0.10 0 0.42" rpy="0 0.61 0"/> -->
    <origin xyz="-0.06 0.0 0.30" rpy="0.0 0.8 0.0"/>
  </xacro:sensor_d435i>
  

  <!-- <sensor_sr300 parent="base_link"/> -->

  <phantomx_pincher_arm parent="base_link" color="Red" gripper_color="Red">
    <origin xyz="0.26 0.0 0.112"/>
  </phantomx_pincher_arm>


</robot>
